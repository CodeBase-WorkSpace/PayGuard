# Non-secret deployment identity. Never put passwords or tokens here.
COMPOSE_PROJECT_NAME=payguard
VAULT_PORT=8200
PAYGUARD_LOCAL_UID=1000
PAYGUARD_LOCAL_GID=1000
PAYGUARD_DOCKER_GID=1000
# Set to the SAME absolute path on the host and operations container.
PAYGUARD_REPO_ROOT=/workspace/payguard
PAYGUARD_RUNTIME_ROOT=/dev/shm/payguard
# PostgreSQL 18 image default. Inspect existing PG_VERSION locations before adoption.
PAYGUARD_PGDATA=/var/lib/postgresql/18/docker
# Existing volume names are explicit and external; they are never auto-created on startup.
PAYGUARD_POSTGRES_IDENTITY_VOLUME=payguard_postgres_identity_data
PAYGUARD_POSTGRES_WALLET_VOLUME=payguard_postgres_wallet_data
PAYGUARD_POSTGRES_LOAN_VOLUME=payguard_postgres_loan_data
PAYGUARD_POSTGRES_COLLATERAL_VOLUME=payguard_postgres_collateral_data
PAYGUARD_VAULT_DATA_VOLUME=payguard_vault_data
PAYGUARD_VAULT_AUDIT_VOLUME=payguard_vault_audit
PAYGUARD_KAFKA_DATA_VOLUME=payguard_kafka_data
